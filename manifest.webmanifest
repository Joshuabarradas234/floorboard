{
  "name": "Floorboard",
  "short_name": "Floorboard",
  "description": "Tasks, feedback, heads-ups and votes that involve you, without scrolling through WhatsApp groups.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#2b2018",
  "theme_color": "#2b2018",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Needs you (sidebar view)",
      "short_name": "Needs you",
      "url": "./#widget",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  }
}